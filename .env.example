# ============================================================
# PRODUCTION-READY ENVIRONMENT CONFIGURATION
# ============================================================

# DATABASE CONFIGURATION
# For Development: Use local PostgreSQL
# Example: postgresql://postgres:password@localhost:5432/script_market?schema=public
#
# For Production (Neon): Use Neon with SSL
# Example: postgresql://user:password@ep-xyz.neon.tech/script_market?sslmode=require&schema=public
DATABASE_URL=""

# Security
# Generate a secure session secret: openssl rand -base64 32
SESSION_SECRET="dev-secret-change-in-production"

# Node Environment
NODE_ENV="development"

# ============================================================
# OPTIONAL: Email Service (Nodemailer)
# ============================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@marketplace.com"

# ============================================================
# OPTIONAL: Payment Gateway (SSLCommerz)
# ============================================================
SSLCOMMERZ_STORE_ID="your-store-id"
SSLCOMMERZ_STORE_PASSWORD="your-store-password"
SSLCOMMERZ_API_URL="https://sandbox.sslcommerz.com"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# DEVELOPMENT SETUP
# ============================================================
# 1. Create .env.local (git-ignored) with your local database:
#    DATABASE_URL="postgresql://postgres:password@localhost:5432/script_market?schema=public"
#
# 2. Start PostgreSQL (Docker):
#    docker run --name postgres -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres
#
# 3. Run migrations:
#    npx prisma migrate dev --name init
#
# 4. Seed database (optional):
#    npx ts-node scripts/seed.ts

# ============================================================
# PRODUCTION DEPLOYMENT
# ============================================================
# 1. Set up Neon PostgreSQL at https://neon.tech
#
# 2. Create .env file (on Vercel) with:
#    DATABASE_URL="postgresql://user:pass@host.neon.tech/dbname?sslmode=require"
#    SESSION_SECRET="secure-random-secret"
#    NODE_ENV="production"
#
# 3. Deploy migrations:
#    npx prisma migrate deploy
#
# 4. Deploy to Vercel with environment variables configured
